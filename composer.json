{
    "name": "microscrap/sdl3-gfx",
    "description": "SDL3 plugin for ScrapyardIO Tubes — DeferredFramebuffer, WindowHandler, Rendering Engine, and Input Handler.",
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com/ecosystem/microscrap/sdl3-gfx/0.7.x/overview",
    "support": {
        "issues": "https://github.com/DeptOfScrapyardRobotics/sdl3-gfx/issues",
        "source": "https://github.com/DeptOfScrapyardRobotics/sdl3-gfx"
    },
    "version": "0.7.3",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-sdl3": "^0.7.0",
        "fabricate/nuts-and-bolts": "^0.7.0",
        "microscrap/sdl3": "^0.7.0",
        "scrapyard-io/tubes": "^0.7.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sdl3",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../../scrapyard-io/tubes",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "Microscrap\\GFX\\SDL3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "scrapyard-io": {
            "providers": [
                "Microscrap\\GFX\\SDL3\\Providers\\SDL3GfxServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "0.7.x-dev",
            "dev-main": "0.7.x-dev"
        }
    },
    "prefer-stable": true
}
